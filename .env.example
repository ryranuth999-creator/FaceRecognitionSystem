# =========================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to source control.
# =========================================================

# ---------- Application ----------
APP_NAME=FaceRecognitionSystem
ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- SQL Server Database ----------
# Example ODBC connection using pyodbc + SQLAlchemy mssql dialect.
# Driver must be installed on the host: "ODBC Driver 17/18 for SQL Server"
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FaceRecognitionDB
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_DRIVER=ODBC Driver 17 for SQL Server

# Set to "sqlite" to run locally without SQL Server (development/testing only)
DB_BACKEND=mssql
SQLITE_PATH=./dev.db

# ---------- Face Recognition ----------
FACE_MATCH_THRESHOLD=0.70
FACE_MODEL=hog
UNKNOWN_FACE_DIR=app/static/unknown_faces
EMBEDDINGS_PER_USER=20

# ---------- Telegram Alerts ----------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=123456789

# ---------- Email Alerts (SMTP) ----------
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
ALERT_EMAIL_RECIPIENTS=security_admin@example.com,manager@example.com

# ---------- Camera ----------
DEFAULT_CAMERA_INDEX=0
DEFAULT_CAMERA_ID=CAM-01
DEFAULT_CAMERA_NAME=Main Entrance
